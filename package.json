{
  "name": "biology-dash",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "tsc && vite build --configLoader native && node scripts/offline.mjs",
    "preview": "vite preview --configLoader native --host 0.0.0.0",
    "test": "vitest run --configLoader native",
    "native:sync": "cap sync",
    "test:browser": "node scripts/browser-test.mjs",
    "test:build": "vite build --configLoader native --mode test --outDir dist-test",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#071e29\" --splashBackgroundColor \"#071e29\""
  },
  "dependencies": {
    "phaser": "4.0.0",
    "@capacitor/core": "8.2.0",
    "@capacitor/android": "8.2.0",
    "@capacitor/ios": "8.2.0",
    "@capacitor/app": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.2.0",
    "typescript": "5.7.3",
    "vite": "6.3.6",
    "vitest": "3.2.4",
    "@playwright/test": "1.55.1",
    "@capacitor/assets": "3.0.5"
  }
}
